# Copy to .env. Every line is optional; the game runs with none of them set.

# The n8n webhook that writes the wizard's lines. It receives one JSON turn and
# answers with { "say": ..., "action": ..., "report": ... } - see n8n/README.md.
N8N_WEBHOOK_URL=

# Optional shared secret, sent as the x-wizard-token header.
N8N_WEBHOOK_TOKEN=

# Seconds to wait for the webhook before falling back to the local script.
N8N_TIMEOUT_S=22

# A Pocket TTS voice name (see say.py for the full list), or a path to a
# .safetensors voice clone.
WIZARD_VOICE=george

# Set to 0 to skip loading Pocket TTS entirely and use the browser's voice.
WIZARD_TTS=1

PORT=8770
